{
  "name": "home-energy-costs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "US home energy cost calculators with state electricity prices from the EIA, updated monthly",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "data:eia": "node --env-file-if-exists=.env scripts/data/fetch-eia.mjs",
    "data:heating": "node --env-file-if-exists=.env scripts/data/fetch-heating.mjs",
    "data:recs": "node scripts/data/fetch-recs.mjs",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:dist",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "deploy": "wrangler deploy",
    "indexnow": "node scripts/ops/indexnow.mjs",
    "metrics": "node scripts/ops/metrics-report.mjs",
    "gsc": "node scripts/ops/gsc-report.mjs",
    "review": "node scripts/ops/monthly-review.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "astro": "7.4.2",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
