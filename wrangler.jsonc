// Cloudflare Workers configuration: an assets-only Worker (no Worker code, no bindings) that
// serves the prerendered site in dist/ on wattsplain.com. Deploy: npm run build && npm run deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wattsplain",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
  },
  // Apex only; www is not set up yet.
  "routes": [{ "pattern": "wattsplain.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
