// Cloudflare Workers configuration: the prerendered site in dist/ is served as static assets on
// wattsplain.com; only /api/* runs Worker code (worker/index.ts: first-party analytics).
// Deploy: npm run build && npm run deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wattsplain",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // With 404-page handling, only these paths reach the Worker.
    "run_worker_first": ["/api/*"],
  },
  // Apex only; www is not set up yet.
  "routes": [{ "pattern": "wattsplain.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Daily aggregate analytics counts (migrations/, worker/index.ts). Created by the owner 2026-10-29.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wattsplain-db",
      "database_id": "009bffcc-db04-4c44-b199-9b04846ddc93",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
