---
import type { GetStaticPaths } from 'astro';

import { APPLIANCES, defaultProfile } from '../../data/appliances';
import { BORDERS } from '../../data/borders';
import PriceTrend from '../../components/PriceTrend.astro';
import {
  ELECTRICITY,
  PRICE_CHANGES,
  STATE_ROWS,
  stateTrend,
  type StateRow,
} from '../../data/electricity';
import { ELECTRIC_BASIS, heatingRow } from '../../data/heating';
import { UTILITIES, stateUtilities, utilityName } from '../../data/utilities';
import Base from '../../layouts/Base.astro';
import { applianceEnergy, cost } from '../../lib/appliance';
import { breakEvenElectricity, perTherm } from '../../lib/heating';
import { cents, dollars, kwh, monthLabel, signedPct } from '../../lib/format';

export const getStaticPaths = (() =>
  STATE_ROWS.map((s) => ({ params: { state: s.slug }, props: { s } }))) satisfies GetStaticPaths;

const { s } = Astro.props as { s: StateRow };
const month = monthLabel(ELECTRICITY.monthly.period);
const prior = monthLabel(ELECTRICITY.monthly.priorPeriod);
const year = ELECTRICITY.annual.year;
const us = ELECTRICITY.us;
const vsUs = ((s.price - us.price) / us.price) * 100;
const borders = BORDERS[s.code] ?? [];
// Alaska and Hawaii border no state; they get the other states of their census division instead.
const neighbours = STATE_ROWS.filter((x) =>
  borders.length ? borders.includes(x.code) : x.division === s.division && x.code !== s.code,
);
const examples = [
  'space-heater',
  'dehumidifier',
  'clothes-dryer',
  'electric-blanket',
  'ceiling-fan',
  'hair-dryer',
]
  .map((id) => APPLIANCES.find((a) => a.id === id)!)
  .map((a) => ({ a, p: defaultProfile(a), e: applianceEnergy(defaultProfile(a)) }));
const trend = stateTrend(s.code);
const changeRank = PRICE_CHANGES.findIndex((c) => c.code === s.code);
const change12 = PRICE_CHANGES[changeRank];
// A typical month's bill needs a price for the whole year, not one month: use the 12-month
// average when the history is there. Use is EIA's latest annual average (an earlier year).
const last12 = trend ? trend.values.slice(-12) : [];
const price12 = last12.length === 12 ? last12.reduce((a, b) => a + b, 0) / 12 : undefined;
const estBill = (s.avgKwh * (price12 ?? s.price)) / 100;
const priceBasis = price12
  ? `the average price over the 12 months to ${month} (${cents(price12)})`
  : `the ${month} price (${cents(s.price)})`;
const monthName = (p: string) => monthLabel(p).split(' ')[0];
const direction = s.change > 0.5 ? 'higher' : s.change < -0.5 ? 'lower' : 'about the same';
const comparison = direction === 'about the same' ? 'about the same as' : `${direction} than`;
const heating = heatingRow(s.code)!;
const heatPump = heating.costs.find((c) => c.system.id === 'heat-pump')!;
const breakEven = breakEvenElectricity(heating.prices.gas, 0.95, 7.8);
const shortMonth = month.replace(/^(\w{3})\w*/, '$1');
// "District of Columbia" pushes the title past what search results show; people search "DC".
const titleName = s.code === 'DC' ? 'Washington, DC' : s.name;
const title = `${titleName} electricity rates: ${cents(s.price)}/kWh (${shortMonth})`;
// Short answers to the questions people search about a state (Search Console, Oct 2026), each
// readable on its own so search snippets and AI assistants can quote it.
const perDay = (monthly: number) => Math.round((monthly * 12) / 365);
const vsUsText =
  Math.abs(vsUs) < 0.5
    ? `about the same as the U.S. average (${cents(us.price)})`
    : `${Math.abs(vsUs).toFixed(0)}% ${vsUs > 0 ? 'above' : 'below'} the U.S. average of ${cents(us.price)}`;
const answers: [string, string][] = [
  [
    `What does electricity cost in ${titleName}?`,
    `Homes in ${titleName} paid an average of ${cents(s.price)} per kWh in ${month}, the latest month published by the U.S. Energy Information Administration. That is ${signedPct(s.change)} from ${prior} and ${vsUsText}. ${titleName} ranks #${s.rank} among the 50 states and DC, where #1 is the most expensive.`,
  ],
  [
    `What is the average electric bill in ${titleName}?`,
    `The average ${titleName} home paid ${dollars(s.avgBillAnnual)} a month in ${year} for ${kwh(s.avgKwh)} of electricity (EIA's latest annual figures). The same use at ${priceBasis} comes to about ${dollars(estBill, 0)} a month. Your bill depends on your home, the season and your utility's fixed charges.`,
  ],
  [
    `How much electricity does a ${titleName} home use per day?`,
    `About ${perDay(s.avgKwh)} kWh a day on average: ${kwh(s.avgKwh)} a month, or ${kwh(s.avgKwh * 12)} a year (EIA, ${year}). The U.S. average is about ${perDay(us.avgKwh)} kWh a day. Homes use more in months with heating or air conditioning, so winter and summer days run above the average.`,
  ],
];
// Prices by utility (EIA-861M): what "electricity rates in <state>" searchers usually want to see,
// since the state average blends utilities that can differ by several cents.
const util = stateUtilities(s.code)!;
const utilMonth = monthLabel(UTILITIES.period);
const utilShort = utilMonth.replace(/^(\w{3})\w*/, '$1');
const utilPriorShort = monthLabel(UTILITIES.priorPeriod).replace(/^(\w{3})\w*/, '$1');
// The range sentence covers utilities serving at least 2% of the state's homes, so a tiny island
// or town utility does not set the "from … to" (it stays in the table).
const ranged = util.utilities.filter(
  (u) => u.price12 !== null && u.customers >= util.customers * 0.02,
);
const cheapest = ranged.reduce<(typeof ranged)[number] | undefined>(
  (a, u) => (!a || u.price12! < a.price12! ? u : a),
  undefined,
);
const dearest = ranged.reduce<(typeof ranged)[number] | undefined>(
  (a, u) => (!a || u.price12! > a.price12! ? u : a),
  undefined,
);
const pct = (x: number) => `${Math.round(x * 100)}%`;
const choiceShare = util.choiceShare ?? 0;
const description = `${s.name} homes paid ${cents(s.price)} per kWh in ${month}, ${signedPct(s.change)} vs a year earlier (EIA). Typical bill, 24-month trend, heating and appliance costs.`;
---

<Base
  title={title}
  description={description}
  crumbs={[
    ['Electricity rates', '/electricity-rates/'],
    [s.name, `/electricity-rates/${s.slug}/`],
  ]}
>
  <h1>{s.name} electricity rates and average bill</h1>
  <p class="lede">
    {`In ${month}, the average residential price in ${s.name} was `}
    <strong>{`${cents(s.price)} per kWh`}</strong>
    {`, ${comparison} a year earlier (${cents(s.pricePrior)}).`}
  </p>
  <p class="updated">
    Source: <a href={ELECTRICITY.monthly.source}>EIA Table 5.6.A</a> ({month}, preliminary) and{' '}
    <a href={ELECTRICITY.annual.source}>EIA {year} averages</a>. Checked {ELECTRICITY.fetchedAt}.
  </p>

  <div class="stats">
    <div class="stat">
      <div class="k">Price, {month}</div>
      <div class="v">{cents(s.price)}</div>
      <div class="s">per kWh</div>
    </div>
    <div class="stat">
      <div class="k">Change since {prior}</div>
      <div class={`v ${s.change > 0 ? 'up' : 'down'}`}>{signedPct(s.change)}</div>
      <div class="s">U.S.: {signedPct(us.change)}</div>
    </div>
    <div class="stat">
      <div class="k">Rank</div>
      <div class="v">#{s.rank} of 51</div>
      <div class="s">1 = most expensive</div>
    </div>
    <div class="stat">
      <div class="k">vs U.S. average</div>
      <div class="v">{signedPct(vsUs, 0)}</div>
      <div class="s">U.S.: {cents(us.price)}</div>
    </div>
  </div>

  {trend && (
    <>
      <h2>{s.name} electricity prices, month by month</h2>
      <PriceTrend
        caption={`Average residential price, ${monthLabel(trend.periods[0]!)} – ${monthLabel(trend.periods.at(-1)!)} (¢/kWh)`}
        periods={trend.periods}
        series={[
          { label: s.name, values: trend.values },
          { label: 'U.S. average', values: trend.us },
        ]}
      />
      <p>
        {`So far in ${trend.ytd.year} (${trend.ytd.months} months), ${s.name} has averaged ${cents(trend.ytd.avg)} per kWh, `}
        <span class={trend.ytd.change > 0 ? 'up' : 'down'}>{signedPct(trend.ytd.change)}</span>
        {` compared with the same months of ${Number(trend.ytd.year) - 1} (${cents(trend.ytd.avgPrior)}). Over the last 12 months the price was highest in ${monthLabel(trend.high.period)} (${cents(trend.high.price)}) and lowest in ${monthLabel(trend.low.period)} (${cents(trend.low.price)}).`}
      </p>
      {change12 && (
        <p>
          {`Averaged over the 12 months to ${month}, the ${s.name} price was ${Math.abs(change12.change12).toFixed(1)}% ${change12.change12 >= 0 ? 'higher' : 'lower'} than in the 12 months before (${changeRank + 1} of 51, from the largest rise), about ${dollars(Math.abs(change12.billEffect))} a month ${change12.billEffect >= 0 ? 'more' : 'less'} at typical use.`}{' '}
          <a href="/electricity-rates/price-changes/">Price changes in every state →</a>
        </p>
      )}
    </>
  )}

  <h2>Electricity prices by utility in {s.name}</h2>
  {ranged.length >= 2 && cheapest && dearest && cheapest.id !== dearest.id ? (
    <p>
      {`What you pay per kWh depends on your utility. Over the 12 months to ${utilMonth}, utilities serving at least 2% of ${s.name} homes averaged from ${cents(cheapest.price12!)} at ${utilityName(cheapest.name)} to ${cents(dearest.price12!)} at ${utilityName(dearest.name)} for full-service homes.`}
    </p>
  ) : (
    <p>
      {`What you pay per kWh depends on your utility. EIA's monthly survey covers ${util.utilities.length === 1 ? 'one utility' : `${util.utilities.length} utilities`} in ${titleName}:`}
    </p>
  )}
  <div class="table-scroll">
    <table>
      <caption>{`Average residential price by utility, ${s.name} (¢/kWh, all charges)`}</caption>
      <thead>
        <tr>
          <th>Utility</th>
          <th class="hide-sm">Homes</th>
          <th>{utilShort}</th>
          <th>12 months</th>
          <th class="hide-sm">{utilPriorShort}</th>
        </tr>
      </thead>
      <tbody>
        {util.utilities.map((u) => (
          <tr>
            <td>
              {utilityName(u.name)} <span class="hint">{u.ownership}</span>
            </td>
            <td class="hide-sm">{u.customers.toLocaleString('en-US')}</td>
            <td>{cents(u.price)}</td>
            <td>{u.price12 === null ? '–' : cents(u.price12)}</td>
            <td class="hide-sm">{u.priceYearAgo === null ? '–' : cents(u.priceYearAgo)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    {`Revenue from full-service homes divided by the kWh they bought (EIA Form 861M, ${utilMonth} preliminary): energy, delivery, fixed charges, taxes and fees together. It is an average, not a tariff rate; a single month can be skewed by billing timing, so the 12-month figure is steadier. These utilities serve ${pct(util.shownShare)} of ${s.name} homes. Smaller utilities${choiceShare >= 0.005 ? ' and homes that buy from a retail supplier' : ''} appear only in EIA's state average.`}{' '}
    <a href={UTILITIES.source}>Source: EIA-861M</a>
  </p>
  {choiceShare >= 0.005 ? (
    <p>
      {s.code === 'TX'
        ? `In ${UTILITIES.choice!.year}, ${pct(choiceShare)} of Texas homes bought electricity from a retail electric provider (EIA-861), mostly in the ERCOT competitive area. There the price depends on the plan you pick, so compare plans' prices per kWh at your own monthly use, not these averages.`
        : `In ${UTILITIES.choice!.year}, ${pct(choiceShare)} of ${s.name} homes bought their electricity supply from a retail supplier or a community aggregation program instead of from their utility (EIA-861); the utility still delivers it. To judge a supplier's offer, compare it with your utility's default supply rate (often shown on the bill as the “price to compare”), not with the all-in averages above.`}
    </p>
  ) : (
    <p>
      {`EIA-861 counts almost no ${s.name} homes buying electricity from a retail supplier (${UTILITIES.choice!.year}), so the price you pay is the rate of the utility that serves your address.`}
    </p>
  )}

  <h2>Why is my electric bill so high in {s.name}?</h2>
  <ul>
    <li>
      {`Price: ${s.name} homes paid ${cents(s.price)} per kWh in ${month}, ${signedPct(s.change)} from ${prior}${trend ? ` (${signedPct(trend.ytd.change)} for ${trend.ytd.year} so far)` : ''}. The U.S. average changed ${signedPct(us.change)}.`}
    </li>
    {trend && trend.high.price - trend.low.price > 0.5 && (
      <li>
        {`Season: the price itself moves through the year, from ${cents(trend.low.price)} in ${monthName(trend.low.period)} to ${cents(trend.high.price)} in ${monthName(trend.high.period)}, on top of the extra heating or cooling you use.`}
      </li>
    )}
    <li>
      {`Use: a typical ${s.name} home uses about ${kwh(s.avgKwh)} a month (${year}). Compare your bill with that, and with the same month last year rather than last month.`}
    </li>
  </ul>
  <p>
    <a href={`/tools/why-is-my-electric-bill-high/?state=${s.code}`}>
      Enter two of your bills to see how much is price and how much is use →
    </a>{' '}
    · <a href="/guides/why-is-my-electric-bill-so-high-in-winter/">Why bills jump in winter →</a>
  </p>

  <h2>Average electric bill in {s.name}</h2>
  <div class="table-scroll">
    <table class="facts">
      <tbody>
        <tr>
          <th scope="row">{`Average monthly use, ${year}`}</th>
          <td>{`${kwh(s.avgKwh)} (U.S.: ${kwh(us.avgKwh)})`}</td>
          <td class="src hide-sm">{`EIA, ${year} annual data`}</td>
        </tr>
        <tr>
          <th scope="row">{`Average monthly bill, ${year}`}</th>
          <td>{dollars(s.avgBillAnnual)}</td>
          <td class="src hide-sm">{`EIA, ${year} prices`}</td>
        </tr>
        <tr>
          <th scope="row">Same use at recent prices (estimate)</th>
          <td>{`about ${dollars(estBill, 0)} a month`}</td>
          <td class="src hide-sm">Our calculation</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="note">
    {`The estimate is ${year} average use × ${priceBasis}. It mixes two periods and is not an actual bill: real bills swing with the season and with each home's use, and include fixed charges that differ by utility.`}
  </p>
  <h2>What common appliances cost to run in {s.name}</h2>
  <p class="note">
    {`At ${cents(s.price)} per kWh (${month} average). Wattages are typical values from the U.S. Department of Energy; schedules are examples, and heaters are counted only in a 5-month heating season.`}
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Appliance</th>
          <th>Watts</th>
          <th>Hours a day</th>
          <th>Per month used</th>
          <th class="hide-sm">Per year</th>
        </tr>
      </thead>
      <tbody>
        {examples.map(({ a, p, e }) => (
          <tr>
            <td>
              {a.name}{' '}
              {p.monthsPerYear < 12 && (
                <span class="hint">{`${p.monthsPerYear} months a year`}</span>
              )}
            </td>
            <td>{a.watts.toLocaleString('en-US')}</td>
            <td>{`${a.hours}${p.dutyCycle < 1 ? ' (cycles)' : ''}`}</td>
            <td>{dollars(cost(e.kwhPerMonthInUse, s.price))}</td>
            <td class="hide-sm">{dollars(cost(e.kwhPerYear, s.price), 0)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    <a href={`/tools/appliance-electricity-cost/?state=${s.code}`}>Calculate any appliance</a> ·{' '}
    <a href={`/tools/space-heater-cost/?state=${s.code}`}>Space heater cost in {s.name}</a>
  </p>

  <h2>Heating costs in {s.name}: heat pump vs gas, propane and oil</h2>
  <p>
    {`The typical gas-heated ${s.name} home needs about ${Math.round(heating.heat)} million Btu of heat a year${heating.heatFromDivision ? ` (${s.division} average; EIA has no separate figure for ${s.name})` : ''}. At current prices the cheapest way to provide it is a ${heating.cheapest.system.name.toLowerCase()}, at about `}
    <strong>{`${dollars(heating.cheapest.perYear, 0)} a year`}</strong>
    {`. A heat pump (HSPF2 7.8) beats a 95% gas furnace here when electricity costs less than ${cents(breakEven)} per kWh; the ${ELECTRIC_BASIS.label} in ${s.name} is ${cents(heatPump.price)}.`}
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>System</th>
          <th>Fuel price</th>
          <th>Per year</th>
        </tr>
      </thead>
      <tbody>
        {heating.costs.map((c) => (
          <tr>
            <td>{c.system.name}</td>
            <td>
              {c.system.fuel === 'kwh'
                ? `${cents(c.price)}/kWh`
                : c.system.id === 'gas'
                  ? `${dollars(perTherm(c.price))}/therm`
                  : `${dollars(c.price)}/gal`}
              {heating.notes[c.system.id] && (
                <>
                  {' '}
                  <span class="hint">{heating.notes[c.system.id]}</span>
                </>
              )}
            </td>
            <td>{dollars(c.perYear, 0)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    <a href={`/tools/heating-cost-calculator/?state=${s.code}`}>
      Compare with your own fuel use and prices →
    </a>{' '}
    ·{' '}
    <a href={`/tools/space-heater-vs-central-heat/?state=${s.code}`}>
      Would a space heater in one room save money? →
    </a>{' '}
    · <a href="/guides/how-much-propane-to-heat-a-house/">Propane by house size →</a>
  </p>

  <h2>Electricity in {titleName}: quick answers</h2>
  {answers.map(([q, a]) => (
    <>
      <h3>{q}</h3>
      <p>{a}</p>
    </>
  ))}

  {neighbours.length > 0 && (
    <>
      <h2>
        {borders.length
          ? `States that border ${s.name}`
          : `Other states in the ${s.division} census division`}
      </h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>State</th>
              <th>{month}</th>
              <th>Change</th>
            </tr>
          </thead>
          <tbody>
            {neighbours.map((n) => (
              <tr>
                <td>
                  <a href={`/electricity-rates/${n.slug}/`}>{n.name}</a>
                </td>
                <td>{cents(n.price)}</td>
                <td class={n.change > 0 ? 'up' : 'down'}>{signedPct(n.change)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
  <p>
    <a href="/electricity-rates/">All states →</a>
  </p>
</Base>
