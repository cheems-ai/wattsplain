---
import { APPLIANCES } from '../../data/appliances';
import { ELECTRICITY, RATE_OPTIONS, STATE_ROWS } from '../../data/electricity';
import ApplianceCost from '../../islands/ApplianceCost';
import Base from '../../layouts/Base.astro';
import { runningCost } from '../../lib/energy';
import { cents, dollars, monthLabel } from '../../lib/format';

const month = monthLabel(ELECTRICITY.monthly.period);
const title = 'Space heater cost calculator: per hour, day and month';
const description = `What a 750 W or 1,500 W space heater costs to run per hour, day and month in your state, at the ${month} electricity price.`;
const us = runningCost(1500, 1, ELECTRICITY.us.price);
const rows = [...STATE_ROWS].sort((a, b) => b.price - a.price);
const top = rows.slice(0, 5);
const bottom = rows.slice(-5).reverse();
---

<Base
  title={title}
  description={description}
  crumbs={[['Space heater cost', '/tools/space-heater-cost/']]}
>
  <h1>Space heater cost calculator</h1>
  <p class="lede">
    At the U.S. average of {cents(ELECTRICITY.us.price)} per kWh ({month}), a 1,500 W space heater
    on high costs about <strong>{dollars(us.perHour)} an hour</strong>. Pick your state to see your
    cost.
  </p>

  <ApplianceCost
    client:load
    rates={RATE_OPTIONS}
    appliances={[...APPLIANCES]}
    fixed={{ id: 'space-heater', presets: [750, 1000, 1500] }}
    monthLabel={month}
  />

  <p>
    Thinking of heating one room and turning the house down?{' '}
    <a href="/tools/space-heater-vs-central-heat/">
      See if a space heater saves money with your central heat →
    </a>
  </p>

  <h2>Cost of a 1,500 W heater, 8 hours a day</h2>
  <div class="table-scroll">
    <table>
      <caption>{`Most and least expensive states, ${month} prices.`}</caption>
      <thead>
        <tr>
          <th>State</th>
          <th>Price</th>
          <th>Per hour</th>
          <th>Per month</th>
        </tr>
      </thead>
      <tbody>
        {[...top, ...bottom].map((s) => {
          const c = runningCost(1500, 8, s.price);
          return (
            <tr>
              <td>
                <a href={`/electricity-rates/${s.slug}/`}>{s.name}</a>
              </td>
              <td>{cents(s.price)}</td>
              <td>{dollars(c.perHour)}</td>
              <td>{dollars(c.perMonth)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <h2>Things that change the cost</h2>
  <ul>
    <li>
      <strong>Setting.</strong> Most portable heaters draw 1,500 W on high and about 750 W on low
      (DOE range: 750–1,500 W).
    </li>
    <li>
      <strong>Thermostat.</strong> A heater with a thermostat switches off when the room is warm, so
      it may run less than the hours you set.
    </li>
    <li>
      <strong>Heater type.</strong> Oil-filled, ceramic and infrared heaters at the same wattage use
      the same electricity per hour; they differ in how the heat feels, not in efficiency.
    </li>
  </ul>
</Base>
