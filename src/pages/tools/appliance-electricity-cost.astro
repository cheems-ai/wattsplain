---
import { APPLIANCES, APPLIANCE_SOURCE } from '../../data/appliances';
import { ELECTRICITY, RATE_OPTIONS } from '../../data/electricity';
import ApplianceCost from '../../islands/ApplianceCost';
import Base from '../../layouts/Base.astro';
import { monthLabel } from '../../lib/format';

const month = monthLabel(ELECTRICITY.monthly.period);
const title = 'Appliance electricity cost calculator (by state)';
const description = `How much an appliance costs to run per hour, day, month and year at your state's ${month} electricity price. Typical wattages from the U.S. Department of Energy.`;
---

<Base
  title={title}
  description={description}
  crumbs={[['Appliance cost', '/tools/appliance-electricity-cost/']]}
>
  <h1>Appliance electricity cost calculator</h1>
  <p class="lede">
    Pick an appliance, check the watts on its label, and see what it costs to run at your state's
    latest electricity price.
  </p>

  <ApplianceCost client:load rates={RATE_OPTIONS} appliances={[...APPLIANCES]} monthLabel={month} />

  <h2>The formula</h2>
  <p>
    kWh a year = watts × running share × hours a day × days used a year ÷ 1,000, plus standby watts
    for the hours it is off. Days used a year = 365 × days a week ÷ 7 × months a year ÷ 12. Cost =
    kWh × your price. A 1,500 W heater running 8 hours uses 12 kWh a day; at 20¢ per kWh that is
    $2.40 a day, or $72 in a 30-day month of use.
  </p>
  <ul>
    <li>
      <strong>Running share.</strong> Heaters, fridges and dehumidifiers switch on and off. At 100%
      the result is the most the appliance can use; lower it if yours cycles.
    </li>
    <li>
      <strong>Season.</strong> Heaters and fans default to part of the year; set the months you
      actually use them.
    </li>
    <li>
      <strong>EnergyGuide label.</strong> For fridges, washers, dishwashers, water heaters and TVs
      you can enter the label's kWh per year instead.
    </li>
    <li>
      <strong>Price.</strong> The state average includes fixed charges spread over every kWh; you
      can use your own price, one worked out from a bill, or a time-of-use blend.
    </li>
  </ul>
  <h2>Where the wattages come from</h2>
  <p>
    Default wattages are typical nameplate values from{' '}
    <a href={APPLIANCE_SOURCE.url}>{APPLIANCE_SOURCE.title}</a>. The label on your appliance is more
    accurate. Appliances with a thermostat or compressor (fridges, freezers, heaters) cycle on and
    off, so they use less than their nameplate wattage × hours.
  </p>
</Base>
