---
import { ELECTRIC_BASIS, HEATING, HEATING_OPTIONS, HEATING_ROWS } from '../../data/heating';
import HeatingCost from '../../islands/HeatingCost';
import Base from '../../layouts/Base.astro';
import { BTU, breakEvenElectricity, heatPumpCop, perTherm, type SystemId } from '../../lib/heating';
import { cents, dollars, monthLabel } from '../../lib/format';

const short = (p: string) => monthLabel(p).replace(/^(\w{3})\w*/, '$1');
const electricLabel = `${ELECTRIC_BASIS.label}, ${short(ELECTRIC_BASIS.from)} – ${short(ELECTRIC_BASIS.to)}`;
const gasLabel = `12 months to ${short(HEATING.gas.period)}`;
const week = new Date(`${HEATING.propane.week}T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const cost = (r: (typeof HEATING_ROWS)[number], id: SystemId) =>
  r.costs.find((c) => c.system.id === id)!.perYear;
const rows = [...HEATING_ROWS].sort((a, b) => a.name.localeCompare(b.name));
const hpWins = HEATING_ROWS.filter((r) => cost(r, 'heat-pump') < cost(r, 'gas'));
const usBreakEven = breakEvenElectricity(HEATING.gas.us.price, 0.95, 7.8);
const propaneWins = (other: SystemId) =>
  HEATING_ROWS.filter((r) => cost(r, 'propane') < cost(r, other)).length;
// Prices at which two systems cost the same per million Btu of heat (default efficiencies).
const propaneHeat = (BTU.propaneGal * 0.95) / 1e6;
const oilHeat = (BTU.oilGal * 0.85) / 1e6;
const usPropane = HEATING.propane.us;
const usOil = HEATING.oil.us;
const hpCentsPerMmbtu = (centsPerKwh: number) =>
  (centsPerKwh / 100 / (BTU.kwh * heatPumpCop(7.8))) * 1e6;
const usElectric = HEATING_ROWS.reduce((a, r) => a + r.prices.electric, 0) / HEATING_ROWS.length;
const propaneVsHeatPump = hpCentsPerMmbtu(usElectric) * propaneHeat;
const propaneVsOil = (usOil / oilHeat) * propaneHeat;
const title = 'Heating cost calculator: heat pump vs gas, propane, oil';
const description = `What a heat pump, gas furnace, propane, heating oil or electric heat costs to run a year in your state, at EIA fuel prices for the week of ${week}.`;
---

<Base
  title={title}
  description={description}
  crumbs={[['Heating cost', '/tools/heating-cost-calculator/']]}
>
  <h1>Heating cost calculator</h1>
  <p class="lede">
    {`What the same amount of heat costs with a heat pump, a gas, propane or oil furnace, or electric baseboard heat, at your state's current fuel prices. At today's prices a heat pump is cheaper to run than a new gas furnace in ${hpWins.length} of 51 states.`}
  </p>
  <p class="updated">
    {`Prices: EIA. Propane and heating oil: week of ${week}. Natural gas: ${gasLabel}. Electricity: ${electricLabel}. Checked ${HEATING.fetchedAt}.`}
  </p>

  <HeatingCost
    client:load
    options={HEATING_OPTIONS}
    electricLabel={electricLabel}
    propaneWeek={week}
    gasLabel={gasLabel}
  />

  <h2>Cheapest way to heat a home in each state</h2>
  <div class="table-scroll">
    <table>
      <caption>
        {`Yearly running cost for the typical gas-heated home in each state (EIA RECS ${HEATING.recs.survey}), with a new heat pump (HSPF2 7.8), a 95% gas or propane furnace and an 85% oil furnace.`}
      </caption>
      <thead>
        <tr>
          <th>State</th>
          <th>Heat pump</th>
          <th>Gas</th>
          <th class="hide-sm">Propane</th>
          <th class="hide-sm">Oil</th>
          <th>Cheapest</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>
              <a href={`/electricity-rates/${r.slug}/`}>{r.name}</a>
            </td>
            <td>{dollars(cost(r, 'heat-pump'), 0)}</td>
            <td>{dollars(cost(r, 'gas'), 0)}</td>
            <td class="hide-sm">
              {`${dollars(cost(r, 'propane'), 0)}${r.national.includes('propane') ? '*' : ''}`}
            </td>
            <td class="hide-sm">
              {`${dollars(cost(r, 'oil'), 0)}${r.national.includes('oil') ? '*' : ''}`}
            </td>
            <td>{r.cheapest.system.name.replace(/ furnace.*| or baseboard/, '')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    Propane and heating oil prices come from the state where EIA surveys it, otherwise from the
    region. * U.S. average: EIA has no price for the state or its region, so that fuel is not
    counted as the cheapest. Homes in warm states need little heat, so every option is cheap there.
  </p>

  <h2>Propane vs electric heat, and propane vs heating oil</h2>
  <ul>
    <li>
      {`Propane vs electric baseboard or furnace: propane is cheaper to run in ${propaneWins('electric')} of 51 states. Resistance heat turns each kWh into ${BTU.kwh.toLocaleString('en-US')} Btu; a 95% propane furnace gets about ${Math.round(propaneHeat * 1e6).toLocaleString('en-US')} Btu from a gallon.`}
    </li>
    <li>
      {`Propane vs a heat pump: the heat pump is cheaper in ${51 - propaneWins('heat-pump')} of 51 states. At the average state electricity price (${cents(usElectric)}), propane would have to cost less than about ${dollars(propaneVsHeatPump)} a gallon to match an HSPF2 7.8 heat pump; the U.S. average was ${dollars(usPropane)} in the week of ${week}.`}
    </li>
    <li>
      {`Propane vs heating oil: propane is cheaper in ${propaneWins('oil')} of 51 states. At the U.S. average oil price of ${dollars(usOil)} a gallon (85% furnace), propane in a 95% furnace matches it at about ${dollars(propaneVsOil)} a gallon.`}
    </li>
  </ul>
  <p>
    Prices for propane and oil are weekly from October to March, and many households buy on a
    contract or a fill-up price that differs. Enter your own price in the calculator above.
  </p>

  <h2>When is a heat pump cheaper than gas?</h2>
  <p>
    {`It depends on the ratio of your electricity price to your gas price. At the U.S. average gas price of ${dollars(perTherm(HEATING.gas.us.price))} per therm, a heat pump with an HSPF2 of 7.8 beats a 95% gas furnace when electricity costs less than about `}
    <strong>{`${cents(usBreakEven)} per kWh`}</strong>
    {'. A more efficient heat pump raises that line; a cheaper gas price lowers it.'}
  </p>
  <ul>
    <li>
      <strong>Cold climates.</strong> HSPF2 is measured for a moderate climate. In the coldest
      weather a heat pump gives fewer units of heat per kWh, and some homes need backup heat, so in
      the northern states real costs can be higher than shown. Cold-climate models hold their
      efficiency better.
    </li>
    <li>
      <strong>Fixed charges.</strong> Dropping gas entirely also saves the monthly gas customer
      charge, which this comparison leaves out.
    </li>
    <li>
      <strong>Equipment cost.</strong> The table compares running costs. Enter installation and
      upkeep quotes in the calculator for a long-term total and a simple payback; rebates and tax
      credits lower the installation figure.
    </li>
  </ul>

  <h2>How the comparison works</h2>
  <p>
    {`We start from the heat a house needs, in million Btu (MMBtu). For the typical home we use EIA's Residential Energy Consumption Survey (${HEATING.recs.survey}): the gas burned for space heating by the average gas-heated home in your state, times 85% for the efficiency of its furnace. With your floor area we scale it by your area ÷ the typical gas-heated home's area (RECS 2020 Table HC10.9); the insulation choice is a ±20% what-if, not a measurement. For the heat pump, the cold-weather choice lowers its seasonal efficiency by 15% or 30%, and backup strip heat supplies the share you enter at 100% efficiency. Each system then needs that heat divided by its efficiency, and the fuel is priced at your state's price. Heat content: 3,412 Btu per kWh, 103,600 Btu per 100 cubic feet of gas (1.036 therms), 91,452 Btu per gallon of propane and 138,500 per gallon of heating oil (EIA). A heat pump's seasonal efficiency is its HSPF2 divided by 3.412.`}
  </p>
  <p>
    <a href="/methodology/">Data & methodology</a> ·{' '}
    <a href="/tools/space-heater-cost/">Space heater cost</a> ·{' '}
    <a href="/tools/space-heater-vs-central-heat/">Space heater vs central heat</a>
  </p>
</Base>
