---
import { SITE } from '../config/site';
import { ELECTRICITY, STATE_ROWS } from '../data/electricity';
import Base from '../layouts/Base.astro';
import { applianceById, defaultProfile } from '../data/appliances';
import { TOOL_GROUPS } from '../data/tools';
import { cents, dollars, monthLabel, signedPct } from '../lib/format';
import { compareScenarios } from '../lib/scenario';

const month = monthLabel(ELECTRICITY.monthly.period);
const prior = monthLabel(ELECTRICITY.monthly.priorPeriod);
const risers = [...STATE_ROWS].sort((a, b) => b.change - a.change).slice(0, 5);
const byName = [...STATE_ROWS].sort((a, b) => a.name.localeCompare(b.name));
// One line per state, shown under the picker as soon as a state is chosen.
const summary = (s: (typeof STATE_ROWS)[number]) =>
  `${s.name}: ${cents(s.price)} per kWh in ${month}, ${s.change >= 0 ? 'up' : 'down'} ` +
  `${Math.abs(s.change).toFixed(1)}% from a year earlier (U.S. average ${cents(ELECTRICITY.us.price)}).`;
// A worked example, computed by the planner's own code at the U.S. average price.
const heater = defaultProfile(applianceById('space-heater')!);
const load = { kind: 'space-heater', name: 'Space heater', ...heater };
const [eight, five] = compareScenarios(
  {
    monthlyKwh: ELECTRICITY.us.avgKwh,
    fixedMonthly: 0,
    fuelPrices: { gas: 0, propane: 0, oil: 0 },
  },
  [
    { name: '8 h', cents: ELECTRICITY.us.price, loads: [load] },
    { name: '5 h', cents: ELECTRICITY.us.price, loads: [{ ...load, hoursPerDay: 5 }] },
  ],
);
---

<Base
  title={`${SITE.name}: electricity prices by state and cost calculators`}
  description={SITE.description}
>
  <h1>What electricity really costs where you live</h1>
  <p class="lede">
    The average U.S. home paid <strong>{cents(ELECTRICITY.us.price)}</strong> per kWh in {month},{' '}
    <span class={ELECTRICITY.us.change > 0 ? 'up' : 'down'}>
      {signedPct(ELECTRICITY.us.change)}
    </span>{' '}
    from a year earlier. Our calculators use your state's latest price from the U.S. Energy
    Information Administration, refreshed every month.
  </p>

  <form class="card start" id="start" action="/electricity-rates/" method="get">
    <label for="home-state">Start with your state</label>
    <div class="start-row">
      <select id="home-state" name="state" required>
        <option value="">Choose a state</option>
        {byName.map((s) => (
          <option value={s.slug} data-code={s.code} data-summary={summary(s)}>
            {s.name}
          </option>
        ))}
      </select>
      <button type="submit" class="go">
        See my state's prices
      </button>
    </div>
    <p class="start-answer" aria-live="polite" hidden></p>
  </form>

  <div class="tasks">
    {TOOL_GROUPS.map((g) => (
      <section class="task" aria-labelledby={`t-${g.id}`}>
        <h2 id={`t-${g.id}`}>{g.title}</h2>
        <p class="note">{g.intro}</p>
        <ul class="tool-list">
          {g.tools.map((t) => (
            <li>
              <a href={t.href} data-tool="">
                {t.title}
              </a>
              <span>{t.text}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <h2>A worked example</h2>
  <p>
    {`A 1,500 W space heater run 8 hours a day through a 5-month heating season, at the U.S. average of ${cents(ELECTRICITY.us.price)} per kWh (${month}), costs about ${dollars(eight!.loads[0]!.perYear, 0)} a year. Running it 5 hours instead saves about `}
    <strong>{`${dollars(-five!.diffPerYear, 0)} a year`}</strong>
    {'. '}
    <a href="/tools/home-energy-savings-planner/">Try it with your own numbers</a>
  </p>

  <h2>
    Biggest price increases, {prior} → {month}
  </h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>State</th>
          <th>{month}</th>
          <th>Change</th>
        </tr>
      </thead>
      <tbody>
        {risers.map((s) => (
          <tr>
            <td>
              <a href={`/electricity-rates/${s.slug}/`}>{s.name}</a>
            </td>
            <td>{cents(s.price)}</td>
            <td class="up">{signedPct(s.change)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    <a href="/electricity-rates/">See all states →</a>
  </p>
</Base>

<script>
  import { track } from '../analytics/client';

  // Picking a state shows its price at once, sends the button to that state's page and carries
  // the state into every calculator link. Without JavaScript the form opens the all-states list.
  const form = document.getElementById('start') as HTMLFormElement;
  const select = document.getElementById('home-state') as HTMLSelectElement;
  const answer = form.querySelector('.start-answer') as HTMLElement;
  const button = form.querySelector('.go') as HTMLButtonElement;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-tool]')];
  links.forEach((a) => a.addEventListener('click', () => track('home-tool')));
  const base = links.map((a) => a.getAttribute('href')!);

  const apply = () => {
    const opt = select.selectedOptions[0];
    const code = select.value ? opt?.dataset.code : undefined;
    answer.hidden = !code;
    answer.textContent = code ? (opt!.dataset.summary ?? '') : '';
    button.textContent = code ? `See ${opt!.textContent!.trim()} prices` : "See my state's prices";
    links.forEach((a, i) => a.setAttribute('href', code ? `${base[i]}?state=${code}` : base[i]!));
  };
  select.addEventListener('change', apply);
  // The browser may restore the last choice on Back.
  apply();
  addEventListener('pageshow', apply);
  form.addEventListener('submit', (e) => {
    if (!select.value) return;
    e.preventDefault();
    location.href = `/electricity-rates/${select.value}/`;
  });
</script>
